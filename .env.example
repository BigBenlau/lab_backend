# Python 不自動讀此檔；本機請 export，Compose 使用 --env-file。
LAB_STORAGE=./storage
# 本機直接啟動時另設 LAB_DEV=true、LAB_ADMIN_ORIGIN=http://127.0.0.1:8001。
LAB_ADMIN_ORIGIN=https://admin.lab.example:9443
LAB_DEV=false
# 目前是功能 demo；gateway 預設只綁本機，兩 API 仍只走 Docker 內網。
ADMIN_BIND_IP=127.0.0.1
ADMIN_HOST=admin.lab.example
LAB_STORAGE_HOST=../storage
TLS_CERT_HOST=../secrets/tls.crt
TLS_KEY_HOST=../secrets/tls.key
LAB_CONTENT_NETWORK=lab-content
