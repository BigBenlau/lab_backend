# 兩個映像共用專案根目錄context與本白名單；各Dockerfile只COPY自身所需檔案。
# 預設排除全部：Git、機密、初始化data/assets、執行庫、根目錄 versions/ 備份及開發資料均不傳給builder。
**

# Python API與離線維護；開目錄後重新排除內容，再逐一放行必要檔案。
!requirements.lock
!lab_backend/
lab_backend/**
!lab_backend/__init__.py
!lab_backend/application.py
!lab_backend/auth.py
!lab_backend/cli.py
!lab_backend/config.py
!lab_backend/content.py
!lab_backend/models.py
!lab_backend/public.py
!lab_backend/store.py
!scripts/
scripts/**
!scripts/maintenance.py
!scripts/prepare_initial_data.py

# 管理頁與Nginx入口設定。
!admin_frontend/
admin_frontend/**
!admin_frontend/admin/
admin_frontend/admin/**
!admin_frontend/admin/index.html
!admin_frontend/admin/app.js
!admin_frontend/admin/style.css
!deploy/
deploy/**
!deploy/Dockerfile
!deploy/Dockerfile.gateway
!deploy/nginx.conf.template
!deploy/acme-stream.conf
!deploy/https-redirect.conf
!deploy/gateway-entrypoint.sh

# 共用gateway只加入官網五個頁面檔案；資料及資產由volume管理。
!public_frontend/
public_frontend/**
!public_frontend/dist/
public_frontend/dist/**
!public_frontend/dist/lab.html
!public_frontend/dist/lab.js
!public_frontend/dist/api.js
!public_frontend/dist/lab.css
!public_frontend/dist/gold.css

# 管理登入頁使用專案既有的品牌圖。
!public_frontend/deliverables/
public_frontend/deliverables/**
!public_frontend/deliverables/logo/
public_frontend/deliverables/logo/**
!public_frontend/deliverables/logo/casino-symbol.svg
