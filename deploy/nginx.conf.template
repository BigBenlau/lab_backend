worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 512; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    log_format minimal '$time_iso8601 $status $request_time';
    access_log /dev/stdout minimal;
    client_body_temp_path /tmp/client;
    proxy_temp_path /tmp/proxy;
    # 即使未使用 FastCGI 等上游，模組初始化也不能寫唯讀的 /var/cache。
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    proxy_max_temp_file_size 0;
    client_max_body_size 256k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    send_timeout 15s;
    keepalive_timeout 20s;
    limit_req_zone $binary_remote_addr zone=admin_rate:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=login_rate:1m rate=6r/m;
    limit_req_status 429;
    proxy_connect_timeout 3s;
    proxy_read_timeout 20s;
    proxy_send_timeout 20s;
    proxy_cache off;
    resolver 127.0.0.11 valid=10s ipv6=off;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_set_header Connection "";
    proxy_http_version 1.1;
    # HTTP 測試不能令瀏覽器記住強制 HTTPS；正式 HTTPS 的 HSTS 保持不變。
    map $scheme $hsts { https "max-age=31536000"; default ""; }
    add_header Strict-Transport-Security $hsts always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control no-store always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

    server {
        include /tmp/transport.conf;
        server_name ${ADMIN_HOST};
        if ($host != "${ADMIN_HOST}") { return 444; }
        # IP 存取由 Cloud 防火牆控制；此處保留合法 Host、TLS 與登入限流。
        set $admin_upstream admin-api:8000;
        # 可連線仍須帳密／Session，API 逐次檢查權限。
        location = /api/v1/auth/login {
            limit_req zone=login_rate burst=3 nodelay;
            proxy_pass http://$admin_upstream;
        }
        location ~ ^/api/v1/(auth|admin)/ {
            limit_req zone=admin_rate burst=20 nodelay;
            proxy_pass http://$admin_upstream;
        }
        # 不把公開 API、healthz 或其他未知 API 前綴代理到管理服務。
        location /api/ { return 404; }
        location / {
            root /srv/admin;
            try_files $uri $uri/ =404;
        }
    }
}
